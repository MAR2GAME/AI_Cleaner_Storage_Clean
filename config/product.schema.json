{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Storage Clean product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "version", "legal", "integrations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "appName", "profileKey", "themeKey"],
      "properties": {
        "applicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
        "appName": { "type": "string", "minLength": 1 },
        "profileKey": { "type": "string", "minLength": 1 },
        "themeKey": { "type": "string", "minLength": 1 }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacyUrl", "termsUrl"],
      "properties": {
        "privacyUrl": { "type": "string", "minLength": 1 },
        "termsUrl": { "type": "string", "minLength": 1 }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustlook"],
      "properties": {
        "trustlook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["apiKey"],
          "properties": {
            "apiKey": { "type": "string" }
          }
        }
      }
    }
  }
}

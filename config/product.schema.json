{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storageclean.local/product.schema.json",
  "title": "Storage Clean product configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "version", "legal"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationId", "appName", "profileKey", "themeKey"],
      "properties": {
        "applicationId": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(\\.[a-zA-Z][a-zA-Z0-9_]*)+$" },
        "appName": { "type": "string", "minLength": 1 },
        "profileKey": { "type": "string", "minLength": 1 },
        "themeKey": { "type": "string", "minLength": 1 }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacyUrl", "termsUrl"],
      "properties": {
        "privacyUrl": { "type": "string", "pattern": "^https://" },
        "termsUrl": { "type": "string", "pattern": "^https://" }
      }
    }
  }
}

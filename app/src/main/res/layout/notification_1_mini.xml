<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    >

    <!--
      SDK 的 iv_push 使用 mipmap/ic_push_*；部分 OEM 图标主题会把 mipmap 内容图重绘成纯色块。
      保留 iv_push 供 SDK 设置（隐藏即可），实际展示改用 drawable 的铃铛图标。
    -->
    <ImageView
        android:src="@drawable/ic_notification_cleaner"
        android:layout_centerVertical="true"
        android:layout_alignParentStart="true"
        android:contentDescription="@null"
        android:id="@+id/iv_brand_icon"
        android:layout_width="35dp"
        android:layout_height="35dp">
    </ImageView>
    <ImageView
        android:id="@+id/iv_push"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
    </ImageView>
    <TextView
        android:id="@+id/tv_detail"
        android:textSize="14sp"
        android:maxWidth="140dp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/iv_brand_icon"
        android:layout_toStartOf="@id/notification_action"
        android:lines="2"
        android:ellipsize="end"
        android:text="Content"
        android:textColor="@color/notification_content"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="60dp">
    </TextView>
    <RelativeLayout
        android:id="@+id/notification_action"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ProgressBar
            android:id="@+id/progress_ripple"
            style="?android:attr/progressBarStyle"
            android:layout_width="70dp"
            android:layout_height="35dp"
            android:indeterminateDrawable="@drawable/pulse_button" />
        <TextView
            android:id="@+id/button"
            android:textSize="12sp"
            android:text="Check"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        </TextView>
    </RelativeLayout>
</RelativeLayout>

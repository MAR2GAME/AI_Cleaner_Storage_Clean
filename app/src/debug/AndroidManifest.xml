<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建：把 Application 换成 DebugMyApp，以便按 -PfakeVirusScan=true
  追加假扫描器模块。release 构建不参与合并，仍使用 MyApp。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name="com.aicleanerstorage.spaceclean.app.DebugMyApp"
        tools:replace="android:name" />

</manifest>

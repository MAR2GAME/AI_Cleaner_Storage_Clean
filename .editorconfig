root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
ktlint_standard_function-naming = disabled
ktlint_standard_filename = disabled

[*.md]
trim_trailing_whitespace = false

[*.ps1]
end_of_line = lf

[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf

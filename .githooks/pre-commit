#!/bin/sh
# Runs encoding and project rule checks before every commit.
# Bypass (discouraged): git commit --no-verify

root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
    pwsh -NoProfile -File "$root/scripts/check-encoding.ps1" || exit $?
    exec pwsh -NoProfile -File "$root/scripts/check-rules.ps1"
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-encoding.ps1" || exit $?
exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-rules.ps1"
